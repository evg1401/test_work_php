{
    "type": "project",
    "require": {
        "php": ">=8.1",
        "laminas/laminas-diactoros": "^3.10",
        "laminas/laminas-httphandlerrunner": "^2.15",
        "league/route": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src/",
            "App\\Routes\\": "routes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
