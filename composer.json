{
    "type": "project",
    "require": {
        "php": ">=8.1",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "3.8.0",
        "laminas/laminas-diactoros": "^3.10",
        "laminas/laminas-httphandlerrunner": "^2.15",
        "league/container": "^5.2",
        "league/route": "^7.0",
        "smarty/smarty": "^5.9",
        "symfony/cache": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src/",
            "App\\Routing\\": "routing/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
